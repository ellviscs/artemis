FIRMS_API_KEY=
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=

# ── Client-side keys (bundled into the browser; only use public/low-risk keys here)
VITE_CARTO_API_KEY=
VITE_EVERY_ORG_API_KEY=
# Optional Python discovery service, for example http://localhost:8000
VITE_DONATION_DISCOVERY_URL=
