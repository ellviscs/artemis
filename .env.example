# ── Server-side keys (read by /api functions and the Vite dev server; never sent to the browser)
FIRMS_API_KEY=
OPENWEATHER_API_KEY=

# ── Client-side keys (bundled into the browser; only use public/low-risk keys here)
VITE_CARTO_API_KEY=
VITE_NEWSDATA_API_KEY=
VITE_EVERY_ORG_API_KEY=
# Configure verified, direct Kitabisa campaign URLs. Do not use the Kitabisa homepage.
VITE_KITABISA_RIAU_URL=
VITE_KITABISA_CENTRAL_KALIMANTAN_URL=
VITE_KITABISA_INDONESIA_URL=
# Optional Python discovery service, for example http://localhost:8000
VITE_DONATION_DISCOVERY_URL=
